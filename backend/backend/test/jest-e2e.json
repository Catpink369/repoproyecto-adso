{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "reporters": [
    "default",
    ["jest-html-reporters", {
      "publicPath": "../reportes",
      "filename": "reporte-integracion.html",
      "pageTitle": "Reporte Pruebas de Integración - Gurama",
      "openReport": false
    }]
  ]
}